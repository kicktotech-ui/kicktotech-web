# ------------------------------------------------------------------
# Kick To Tech 2.0 — environment template (frontend phase)
# ------------------------------------------------------------------
# NOTE: This frontend phase runs entirely on MOCK services. None of the
# values below are required to run `npm run dev`. They document the
# integration points for the LATER backend phase.
#
# SECURITY: Never place private secrets (Brevo key, Razorpay secret,
# Firebase Admin credentials) in NEXT_PUBLIC_* or in client code.
# Those belong to server-side code only (API routes / Worker).

# Toggles the service layer between "mock" and "firebase"/"api" later.
NEXT_PUBLIC_SERVICE_MODE=mock

# --- Public, non-secret client config (safe to expose) ---
NEXT_PUBLIC_SITE_URL=https://kicktotech.in
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Server-only secrets (DO NOT prefix with NEXT_PUBLIC_) ---
# BREVO_API_KEY=
# BREVO_TEMPLATE_ID=1
# BREVO_SENDER_EMAIL=internships@kicktotech.in
# BREVO_SENDER_NAME=KICK To TECH
# BREVO_WELCOME_TEMPLATE_ID=   # Brevo template for the post-verification welcome email.
#                               # Falls back to BREVO_TEMPLATE_ID if not set.
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# FIREBASE_SERVICE_ACCOUNT=

# --- Admin Platform V2 (dev-only mock auth) ---
# The admin console uses a mock auth layer in this phase. Set the expected
# dev admin email here (defaults to admin@kicktotech.in). Put the real value
# only in .env.local, which is git-ignored. NEVER commit a real password, and
# do not place a real password in client-exposed (NEXT_PUBLIC_) variables.
NEXT_PUBLIC_ADMIN_DEV_EMAIL=admin@kicktotech.in
# ADMIN_DEV_PASSWORD=   # (server-side only, Phase 2 — do not commit)

# ==================================================================
# Phase 2 — Backend foundation (/api/v1). Real values go in .env.local
# (git-ignored). NEVER commit real secrets; none belong in NEXT_PUBLIC_*.
# ==================================================================

# HMAC key that signs session cookies. REQUIRED in production. Generate a long
# random value, e.g.  openssl rand -base64 48
AUTH_SESSION_SECRET=
# Session lifetime in hours (default 24)
AUTH_SESSION_TTL_HOURS=24

# Admin bootstrap (DEV/OPS ONLY). If no admin exists and this is set, the first
# admin login provisions the SUPER_ADMIN with this password (hashed). Do NOT
# commit a real value; unset it in production and provision admins via ops.
AUTH_ADMIN_BOOTSTRAP_PASSWORD=

# Admin identity (routing/bootstrap only — NOT a credential/secret).
# ADMIN_EMAIL=admin@kicktotech.in

# --- Future Cloudflare data adapter (Phase 3 — not required to run locally) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# ==================================================================
# Phase 2.5 — Firebase integration (LOCAL). Real values go in .env.local.
# ==================================================================

# Firebase CLIENT (web) config — PUBLIC (safe in browser). Used by the client
# SDK for Firebase Auth + real-time Firestore reads (onSnapshot).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase ADMIN (server) — SECRET service account. Required for privileged
# server-side Firestore access. NEVER commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Data backend selector: "memory" (default) or "firebase" (after admin creds +
# confirmed collection schema).
DATA_BACKEND=memory

# Firestore collection names for the FirebaseDataStore. Set these to the REAL
# existing collection names (confirm with: node scripts/firebase-inspect.mjs).
# Defaults are namespaced (ktt_*) so nothing writes to an existing collection
# until you deliberately point them at the real ones.
FIREBASE_COLLECTION_USERS=ktt_users
FIREBASE_COLLECTION_SESSIONS=ktt_sessions
FIREBASE_COLLECTION_CERTIFICATES=ktt_certificates
FIREBASE_COLLECTION_AUDIT=ktt_audit_logs

# --- Manual UPI + WhatsApp payment (NOT a payment gateway) ---
# Operational config shown to users on the payment page. Not secrets.
# The UPI ID + WhatsApp number are provided by ops; safe placeholders are used
# if unset. No gateway/order/webhook is involved — verification is manual.
# PAYMENT_UPI_ID=example@upi
# PAYMENT_PAYEE_NAME=Kick To Tech
# PAYMENT_AMOUNT=222
# PAYMENT_WHATSAPP_NUMBER=919999999999   # digits only, incl. country code, no +
# PAYMENT_NOTE=Kick To Tech certificate processing fee
# PAYMENT_WHATSAPP_TEMPLATE=Hello, I have completed the certificate payment.\n\nName: {name}\nDomain: {domain}\nApplication ID: {applicationId}\nAmount: ₹{amount}\n\nI am sending my payment proof for verification.
